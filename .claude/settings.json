{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/claude/workflow/bin/session-arm.sh\"; [ -x \"$f\" ] && \"$f\" || true"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/claude/workflow/bin/after-compact.sh\"; [ -x \"$f\" ] && \"$f\" || true"
          }
        ]
      }
    ]
  }
}
