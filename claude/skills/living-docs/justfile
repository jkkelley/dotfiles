# living-docs - the OS-aware entry point.
#
# Every recipe here works the same on Linux and on Windows. The difference the
# recipes hide is where the container runtime lives: native on Linux, inside WSL
# on Windows, where podman is not on the host at all.
#
# Install just:
#   Windows   winget install Casey.Just
#   Debian    apt install just     (or cargo install just)
#
# Set WSL_DISTRO if the default WSL distribution is not the one holding podman.

set windows-shell := ["bash", "-cu"]

# Pinned by digest per root CLAUDE.md Rule 15. Tag shown for the next reader.
# docker.io/bitnami/git:latest as of 2026-08-23
IMAGE := "docker.io/bitnami/git@sha256:1baa6ddbde79fa7ba2fdf441cea47c4f04fae067504d9265e416358db0879ab2"

_default:
    @just --list --unsorted

# Run the test suite in a container. Rule 14: never on the host.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    HERE=$(cd "$(dirname "{{justfile()}}")" && pwd)
    if [ "{{os()}}" = "windows" ]; then
      WIN=$(cygpath -w "$HERE")
      SKILL=$(wsl.exe ${WSL_DISTRO:+-d "$WSL_DISTRO"} -- wslpath -a "$WIN" | tr -d '\r')
      RUN=(wsl.exe ${WSL_DISTRO:+-d "$WSL_DISTRO"} -- podman)
    else
      SKILL="$HERE"
      RUN=(podman)
    fi
    WORK=$("${RUN[@]}" unshare mktemp -d 2>/dev/null || echo /tmp/living-docs-work)
    "${RUN[@]}" run --rm --userns=keep-id --network=none --entrypoint="" \
      -v "$SKILL:/skill:ro,Z" -v "$WORK:/work:Z" -w /work \
      {{IMAGE}} bash /skill/testing/run-tests.sh

# Write docs/README.md into a project.
init PROJECT:
    @bash "$(dirname "{{justfile()}}")/scripts/docs.sh" init --project "{{PROJECT}}"

# Append a decision record. Pass the rest as flags after --.
adr PROJECT *FLAGS:
    @bash "$(dirname "{{justfile()}}")/scripts/docs.sh" adr --project "{{PROJECT}}" {{FLAGS}}

# Append a standard operating procedure.
sop PROJECT *FLAGS:
    @bash "$(dirname "{{justfile()}}")/scripts/docs.sh" sop --project "{{PROJECT}}" {{FLAGS}}

# The gate. Exit 3 when a document lacks a mode or a review date.
verify PROJECT:
    @bash "$(dirname "{{justfile()}}")/scripts/docs.sh" verify --project "{{PROJECT}}"

# Print the four Diataxis modes.
modes:
    @bash "$(dirname "{{justfile()}}")/scripts/docs.sh" modes
