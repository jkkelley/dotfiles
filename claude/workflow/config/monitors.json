{
  "$comment": "The monitoring tab of a line: every monitor declared once, placed by bin/monitors.sh at its slot (row.col of the 3x3). ${line}, ${ws}, ${repo} and any ${ENV_NAME} are substituted when the pane is started. interval 0: the command runs for as long as the pane does; interval N: it is re-run every N seconds. down runs on monitors-down, before the tab closes. Seats add their own entry and edit no one else's (architect, 2026-10-16T04:36Z).",
  "tab": "${line} monitor",
  "grid": "3x3",
  "monitors": [
    {
      "name": "bus",
      "owner": "line-watch",
      "slot": "1.1",
      "interval": 0,
      "command": "make -C ${repo} bus-up && make -C ${repo} bus-health-loop",
      "down": "make -C ${repo} bus-down"
    },
    {
      "name": "sweep",
      "owner": "line-watch",
      "slot": "1.2",
      "interval": 0,
      "command": "make -C ${repo} line-sweep LINE=${line} WS=${ws}",
      "down": "make -C ${repo} line-watch-stop LINE=${line} WS=${ws}"
    },
    {
      "name": "consume",
      "owner": "line-watch",
      "slot": "1.3",
      "interval": 0,
      "command": "make -C ${repo} line-consume LINE=${line} WS=${ws} LW_RESULTS=${LW_RESULTS}"
    },
    {
      "name": "resources",
      "owner": "resources",
      "slot": "2.1",
      "interval": 0,
      "command": "make -C ${repo} seat-resources-loop LINE=${line}",
      "publishes": "res.${line}.<seat>"
    },
    {
      "name": "events",
      "owner": "line-watch",
      "slot": "2.2",
      "interval": 0,
      "command": "make -C ${repo} bus-tail"
    },
    {
      "name": "a2a",
      "owner": "a2a-guard",
      "slot": "2.3",
      "interval": 0,
      "command": "make -C ${repo} a2a-deliver-loop LINE=${line}",
      "publishes": "a2a.${line}.<seat>"
    },
    {
      "name": "stuck-watch",
      "owner": "stuck-watch",
      "slot": "3.1",
      "interval": 0,
      "command": "make -C ${repo} stuck-watch-loop LINE=${line}",
      "publishes": "line.${line}.stuck.<code>, line.${line}.heartbeat"
    },
    {
      "name": "node-timing",
      "owner": "timing",
      "slot": "3.2",
      "interval": 0,
      "command": "make -C ${repo} node-timing-loop",
      "publishes": "$KV.TIMING.<line>.<kind>.<node>.<run>, line.<line>.timing.SLOW"
    },
    {
      "name": "pr-flow",
      "owner": "merge-port",
      "slot": "3.3",
      "interval": 0,
      "command": "make -C ${repo} pr-flow-consume",
      "down": "make -C ${repo} pr-flow-consume-stop"
    },
    {
      "name": "pane-look",
      "owner": "stuck-watch",
      "slot": "3.3",
      "interval": 0,
      "command": "make -C ${repo} pane-look-loop LINE=${line} WS=${ws}",
      "publishes": "line.${line}.stuck.QUEUED-STALE, line.${line}.stuck.IDLE-STALE"
    }
  ]
}
