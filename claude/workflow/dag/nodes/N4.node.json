{
  "schema_version": 1,
  "id": "N4",
  "version": "1.0.0",
  "title": "build",
  "script": "claude/workflow/bin/workflow-spawn.sh",
  "depends_on": [
    "N3"
  ],
  "input": {
    "path": "records/N4.input.json",
    "schema_version": 1
  },
  "output": {
    "path": "records/N4.output.json",
    "schema_version": 1
  },
  "checklist": [
    {
      "box": "Every acceptance criterion has a proof",
      "proof": "proof row per criterion in state.json"
    },
    {
      "box": "Commits touch only the declared files",
      "proof": "git diff --name-only against touches"
    }
  ],
  "bundle": {
    "checklist_doc": "claude/workflow/dag/nodes/N4.node.json",
    "runbook": "claude/workflow/runbooks/RB-dag-intake.md",
    "playbook": "claude/workflow/dag/playbooks/PB-intake.md",
    "docs": [
      "docs/design/dag-state.md",
      "docs/design/dag-state.spec.xml",
      "docs/design/dag-state-nodes.spec.xml",
      "claude/workflow/dag/schemas/node.schema.json",
      "claude/workflow/dag/schemas/state.schema.json"
    ]
  },
  "retry": {
    "max": 3,
    "waits_seconds": [
      5,
      30,
      120
    ],
    "idempotent": true
  },
  "serial": null,
  "parallel": "per file-set"
}
