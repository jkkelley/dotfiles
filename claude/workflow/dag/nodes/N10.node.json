  "script": "claude/workflow/dag/bin/dag-ship.sh",
  "depends_on": [
    "N9"
  ],
  "input": {
    "path": "records/N10.input.json",
    "schema_version": 1
  },
  "output": {
    "path": "records/N10.output.json",
