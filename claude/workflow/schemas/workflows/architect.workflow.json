{
  "schema_version": "1.0.0",
  "id": "architect",
  "version": "1.0.0",
  "title": "Architect a scoped change on the owner's model chain",
  "why": "Prevents an architect seat from dying on one provider's rate limit or spend cap with nobody noticing. The owner ranks the models kimi-k3, opus, codex-sol; the chain is declared here so the spawner and the seat watcher read one order and a hot swap never waits on a human.",
  "trigger": {
    "on": "manual",
    "condition": "The orchestrator needs a design, a plan or a ticket breakdown before any builder seat starts."
  },
  "agent": {
    "role": "architect",
    "models": [
      {
        "id": "kimi-k3",
        "launcher": "kimi-claude",
        "herdr_kind": "claude",
        "surface": "lavish"
      },
      {
        "id": "opus",
        "launcher": "claude",
        "herdr_kind": "claude",
        "model": "claude-opus-5-5",
        "surface": "artifact"
      },
      {
        "id": "codex-sol",
        "launcher": "codex",
        "herdr_kind": "codex",
        "model": "gpt-5.6-sol",
        "surface": "lavish"
      }
    ],
    "effort": "high",
    "context_threshold_percent": 30,
    "allowed_tools": [
      "Bash",
      "Read",
      "Grep",
      "Glob"
    ],
    "denied_tools": [
      "Agent",
      "Task",
      "Edit",
      "Write"
    ],
    "denied_commands": [
      "gh",
      "git commit",
      "git push",
      "git merge",
      "git rebase",
      "git reset --hard",
      "git checkout main",
      "sudo",
      "rm -rf /"
    ],
    "allowed_paths": []
  },
  "gates": [
    {
      "id": "declarations",
      "command": "bash claude/workflow/bin/workflow-spec.sh --validate",
      "expect": "exit-zero",
      "why": "An architect's output is handed to builders as declarations and briefs; a declaration that does not validate cannot be spawned."
    }
  ],
  "exit": {
    "condition": "The plan is on the owner's surface for this link, and the seat has reported its first line to the principal and exited.",
    "verified_by": "bash claude/workflow/bin/watch-ctl.sh status seat <pane>"
  },
  "on_failure": [
    {
      "case": "the active link is rate limited, out of credit or stalled",
      "action": "bin/seat-watch.sh hot swaps to the next link in the same pane and worktree with a handover packet.",
      "outcome": "swapped",
      "runbook": "runbooks/RB-failover.md"
    },
    {
      "case": "every link in the chain is exhausted",
      "action": "The watcher raises one ALERT and prompts the principal. Nothing waits on the owner.",
      "outcome": "exhausted",
      "runbook": "runbooks/RB-failover.md"
    }
  ],
  "record": {
    "emitted_to": "state:records/architect.jsonl",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "workflow",
        "workflow_version",
        "at",
        "role",
        "outcome",
        "link"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "workflow": {
          "const": "architect"
        },
        "workflow_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "role": {
          "const": "architect"
        },
        "outcome": {
          "enum": [
            "planned",
            "swapped",
            "exhausted",
            "blocked"
          ]
        },
        "link": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "ticket": {
          "type": "string",
          "minLength": 2
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
