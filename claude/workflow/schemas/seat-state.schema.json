{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zenith.a2a.seat-state.v1",
  "title": "Seat state row",
  "description": "ONE line of a seat's JSONL state file (brief output.state_file). The seat appends a row per step; after a compaction it resumes from the last done row.",
  "type": "object",
  "additionalProperties": false,
  "required": ["step", "status", "at", "proof"],
  "properties": {
    "step": {"type": "string", "minLength": 1, "description": "The brief's action or AC id."},
    "status": {"enum": ["started", "done", "failed", "skipped"]},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "UTC, always."},
    "proof": {"type": "string"}
  },
  "if": {"properties": {"status": {"enum": ["done", "failed"]}}, "required": ["status"]},
  "then": {"properties": {"proof": {"minLength": 1}}}
}
