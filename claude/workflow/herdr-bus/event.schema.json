{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-bus/event/1",
  "title": "A herdr agent status change, published to NATS subject herdr.<workspace>.<tab>.<pane>.<agent>.<status>",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "at", "workspace", "tab", "pane", "agent", "status", "prev", "owner"],
  "properties": {
    "schema": { "const": "herdr-bus/event/1" },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$" },
    "workspace": { "type": "string", "minLength": 1 },
    "workspace_label": { "type": "string" },
    "tab": { "type": "string", "minLength": 1 },
    "tab_label": { "type": "string" },
    "pane": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "status": { "enum": ["idle", "working", "blocked", "done", "unknown", "gone"] },
    "prev": { "enum": ["idle", "working", "blocked", "done", "unknown", "gone", "none"] },
    "owner": { "type": "boolean", "description": "true when the status needs the owner to see it; the notify consumer shows a toast for these and nothing else" }
  }
}
