{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inbox-sweep.config.schema.json",
  "title": "Inbox sweep config",
  "description": "~/.config/zenith/inbox-sweep/config.json. Lives outside the repository: account addresses are personal data and appear only in run dirs, which make prune removes (spec section config).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gmail",
    "proton",
    "linkedin"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mark_read": {
      "type": "boolean",
      "default": true,
      "description": "Design D1. Marking read is the only mutation a seat may make, and only when this is true."
    },
    "gmail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254,
          "description": "A label only; the connector decides the mailbox."
        }
      }
    },
    "proton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "accounts"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "description": "One seat per item, named proton-<label> (design D4).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "address"
            ],
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "address": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+$",
                "maxLength": 254
              }
            }
          }
        }
      }
    },
    "linkedin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_drafts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 10
        }
      }
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 14,
      "description": "Design D6. make prune removes run dirs older than this."
    },
    "reply_batch_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "default": 10,
      "description": "Design 18.4. Replies per LinkedIn send batch; one seat and one owner line per batch, the rest stay RP-READY for the next batch."
    }
  }
}
