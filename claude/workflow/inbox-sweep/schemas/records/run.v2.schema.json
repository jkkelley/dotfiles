{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inbox-sweep.records.run.v2.schema.json",
  "title": "Run record v2 (design 15.2)",
  "description": "run.json as sweep-init.sh writes it: an integer schema_version, the seat declarations, the owner words hash and the pinned node versions. Written once by init (ruling R3); seat and controller state live in their own records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "seats", "win_home", "owner_words_sha256", "node_versions", "started_at", "finished_at", "cleaned_at", "steps"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat", "source", "account", "status", "pane", "deadline_at", "attempts"],
        "properties": {
          "seat": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "account": { "type": "string" },
          "status": { "type": "string", "minLength": 1 },
          "pane": { "type": ["string", "null"] },
          "deadline_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$" },
          "attempts": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "win_home": { "type": "string" },
    "owner_words_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "node_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },
    "cleaned_at": { "type": ["string", "null"] },
    "steps": { "type": "array" }
  }
}
