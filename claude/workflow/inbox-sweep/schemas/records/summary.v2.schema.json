{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inbox-sweep.records.summary.v2.schema.json",
  "title": "Run summary v2 (V2)",
  "description": "summary.json from V2 on: the same fields as v1, schema_version the integer 2. Written only by sweep-collect.sh.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "seats",
    "finished_at",
    "steps",
    "steps_failed",
    "checklist_rows"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$"
    },
    "status": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seat",
          "status",
          "before",
          "after",
          "processed",
          "flagged"
        ],
        "properties": {
          "seat": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "before": {
            "type": [
              "integer",
              "null"
            ]
          },
          "after": {
            "type": [
              "integer",
              "null"
            ]
          },
          "processed": {
            "type": "integer"
          },
          "flagged": {
            "type": "integer"
          }
        }
      }
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"
    },
    "steps": {
      "type": "integer",
      "minimum": 0
    },
    "steps_failed": {
      "type": "integer",
      "minimum": 0
    },
    "checklist_rows": {
      "type": "integer",
      "minimum": 0
    }
  }
}
