{
  "$comment": "pr-flow per repository (pr-process.md section 10). Every key is overridable by VAR=value on the Make target. clone is the local checkout regen-conflicts and merge.sh's cleanup run in; ci feeds pr-flow-ci-render.sh when the templates are installed. stale_red.mode is update-branch (merge base into head, new pull_request event, fresh merge ref), rerun (gh run rerun --failed, same merge ref, for flakes) or off. autofix.mode on or off; a red PR whose failed check names match on_checks gets each fix whose detect exits non-zero, run in a temp worktree of its head, committed and pushed once per head. No per-repo override",
  "defaults": {
    "line": "pr-flow",
    "merge": "action",
    "records": "bus",
    "ticket_re": "(WO-[0-9]{8}-[0-9a-f]{4})",
    "required_check": "ci-ok",
    "ignore_paths": "events",
    "regen": {
      "paths": "",
      "cmd": ""
    },
    "cleanup": {
      "slots": false
    },
    "backstop_s": 120,
    "stale_red": {
      "mode": "update-branch"
    },
    "autofix": {
      "mode": "on",
      "on_checks": "^(headers|markdown contents lists)$",
      "fixes": [
        {
          "name": "tracked-ignored",
          "detect": "test -z \"$(git ls-files -ci --exclude-standard)\"",
          "fix": "git ls-files -ci -z --exclude-standard | xargs -0r git rm --cached -q"
        },
        {
          "name": "md-contents",
          "detect": "BASE=origin/$PR_BASE bash \"$DOTFILES/scripts/md-contents.sh\" check",
          "fix": "BASE=origin/$PR_BASE bash \"$DOTFILES/scripts/md-contents.sh\" write"
        }
      ]
    },
    "budgets": {
      "N4": {
        "budget_s": 120,
        "timeout_s": 300
      },
      "sweep": {
        "budget_s": 60,
        "timeout_s": 240
      }
    },
    "ci": {
      "workflows": [
        "ci"
      ],
      "dispatch": "",
      "pr_targets": [
        "lint",
        "test"
      ],
      "main_targets": [
        "lint-all",
        "test-all"
      ],
      "setup": "",
      "cache_paths": "~/.cache",
      "cache_keys": "'**/uv.lock', '**/package-lock.json'"
    }
  },
  "repos": {
    "jkkelley/dotfiles": {
      "clone": "~/dotfiles",
      "required_check": "what has to run",
      "regen": {
        "paths": "work-orders/INDEX.md work-orders/*/README.md",
        "cmd": "bash claude/skills/work-order/scripts/work-order.sh reindex"
      },
      "ci": {
        "workflows": [
          "skill PR gate",
          "skill PR intent",
          "rolodex check",
          "a2a lint"
        ],
        "dispatch": "skill-publish.yml",
        "installed": [
          "merge-on-green"
        ]
      }
    },
    "jkkelley/ypconsult-01-src": {
      "clone": "~/projects/ypconsult-01-src",
      "ci": {
        "pr_targets": [
          "lint",
          "typecheck",
          "test",
          "validate"
        ],
        "main_targets": [
          "lint-all",
          "typecheck-all",
          "test-all",
          "validate"
        ],
        "setup": "setup",
        "cache_paths": "~/.cache/uv",
        "installed": [
          "ci",
          "merge-on-green"
        ]
      }
    },
    "jkkelley/business": {
      "clone": "~/projects/business",
      "ci": {
        "pr_targets": [
          "none"
        ],
        "main_targets": [
          "none"
        ],
        "installed": [
          "ci",
          "merge-on-green"
        ]
      }
    }
  }
}
